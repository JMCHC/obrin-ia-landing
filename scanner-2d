import React, { useState, useEffect, useRef } from 'react';

const CapturaObrin = () => {
  // Referencias HTML
  const videoRef = useRef(null);
  const canvasRef = useRef(null);

  // Estados de permisos
  const [permisosActivos, setPermisosActivos] = useState(false);
  const [errorSistema, setErrorSistema] = useState('');

  // Estados del flujo de captura
  // 0: Pedir permisos, 1: Tomar foto 1, 2: Girando para foto 2, 3: Mostrar resultados
  const [paso, setPaso] = useState(0);
  const [fotos, setFotos] = useState([]);
  
  // Estados del Giroscopio
  const [anguloInicial, setAnguloInicial] = useState(null);
  const [anguloActual, setAnguloActual] = useState(0);
  const [estaEstable, setEstaEstable] = useState(false);

  // Configuración del traslape
  const GRADOS_OBJETIVO = 25; // Ángulo a girar a la derecha
  const MARGEN_ERROR = 2;     // +/- 2 grados de tolerancia

  // --------------------------------------------------------
  // 1. INICIALIZACIÓN Y PERMISOS
  // --------------------------------------------------------
  const iniciarHerramienta = async () => {
    try {
      // A. Pedir permiso de Cámara
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'environment', width: { ideal: 1920 }, height: { ideal: 1080 } },
        audio: false
      });
      if (videoRef.current) {
        videoRef.current.srcObject = stream;
      }

      // B. Pedir permiso de Giroscopio (Requerido para iOS 13+)
      if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function') {
        const permisoGiroscopio = await DeviceOrientationEvent.requestPermission();
        if (permisoGiroscopio !== 'granted') {
          setErrorSistema('Se requiere acceso al sensor de movimiento para guiar la captura.');
          return;
        }
      }

      setPermisosActivos(true);
      setPaso(1); // Pasamos a tomar la primera foto
    } catch (err) {
      console.error(err);
      setErrorSistema('Error al acceder a la cámara. Revisa los permisos.');
    }
  };

  // --------------------------------------------------------
  // 2. CAPTURA Y PROCESAMIENTO DE IMAGEN
  // --------------------------------------------------------
  const capturarFotograma = () => {
    const video = videoRef.current;
    const canvas = canvasRef.current;
    if (!video || !canvas) return null;

    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    return canvas.toDataURL('image/jpeg', 0.9); // Retorna la imagen en Base64
  };

  const tomarPrimeraFoto = () => {
    const foto = capturarFotograma();
    if (foto) {
      setFotos([foto]);
      setAnguloInicial(anguloActual);
      setPaso(2); // Pasamos a buscar la segunda foto
    }
  };

  // Limpiar la cámara al desmontar el componente
  useEffect(() => {
    return () => {
      if (videoRef.current && videoRef.current.srcObject) {
        videoRef.current.srcObject.getTracks().forEach(track => track.stop());
      }
    };
  }, []);

  // --------------------------------------------------------
  // 3. LÓGICA DEL GIROSCOPIO Y AUTO-DISPARO
  // --------------------------------------------------------
  useEffect(() => {
    if (paso !== 1 && paso !== 2) return;

    const manejarOrientacion = (evento) => {
      // En dispositivos web, alpha indica la rotación en el eje Z (0 a 360)
      if (evento.alpha !== null) {
        setAnguloActual(evento.alpha);
      }
    };

    window.addEventListener('deviceorientation', manejarOrientacion);
    return () => window.removeEventListener('deviceorientation', manejarOrientacion);
  }, [paso]);

  // Cálculo de progreso (cuánto falta para llegar al objetivo)
  let progreso = 0;
  let enPosicion = false;
  
  if (anguloInicial !== null && paso === 2) {
    // Calculamos diferencia asumiendo que el círculo se reinicia en 360/0
    let diferencia = anguloInicial - anguloActual;
    if (diferencia < -180) diferencia += 360;
    if (diferencia > 180) diferencia -= 360;

    progreso = diferencia; 
    enPosicion = Math.abs(progreso - GRADOS_OBJETIVO) <= MARGEN_ERROR;
  }

  // El "Francotirador" (Temporizador para disparo automático)
  useEffect(() => {
    let temporizador;
    
    if (paso === 2 && enPosicion) {
      setEstaEstable(true);
      // Si se mantiene estable por 1.2 segundos, dispara
      temporizador = setTimeout(() => {
        const foto2 = capturarFotograma();
        if (foto2) {
          setFotos(prev => [...prev, foto2]);
          setPaso(3); // Terminó la captura
        }
      }, 1200);
    } else {
      setEstaEstable(false);
    }

    // Si el usuario mueve el celular antes de 1.2s, cancelamos el temporizador
    return () => clearTimeout(temporizador);
  }, [enPosicion, paso]);

  // --------------------------------------------------------
  // 4. INTERFAZ DE USUARIO (RENDER)
  // --------------------------------------------------------
  return (
    <div className="relative w-full h-screen overflow-hidden bg-gray-900 text-white font-sans">
      
      {/* Elementos ocultos técnicos */}
      <canvas ref={canvasRef} className="hidden" />

      {/* Pantalla de Permisos */}
      {paso === 0 && (
        <div className="absolute inset-0 z-50 flex flex-col items-center justify-center p-6 text-center bg-gray-900">
          <div className="w-16 h-16 mb-6 bg-blue-600 rounded-lg flex items-center justify-center">
            {/* Ícono de cámara improvisado */}
            <span className="text-3xl">📷</span>
          </div>
          <h1 className="text-2xl font-bold mb-2">Escáner de Muros</h1>
          <p className="text-gray-400 mb-8 max-w-sm">
            Para iniciar el levantamiento, Obrín IA necesita acceso a tu cámara y al sensor de movimiento de tu dispositivo.
          </p>
          {errorSistema && <p className="text-red-400 mb-4 bg-red-900/30 p-3 rounded">{errorSistema}</p>}
          <button 
            onClick={iniciarHerramienta}
            className="bg-blue-600 hover:bg-blue-500 w-full max-w-xs py-4 rounded-xl font-bold text-lg transition-all"
          >
            Habilitar Sensores
          </button>
        </div>
      )}

      {/* Feed de la Cámara (Visible en Paso 1 y 2) */}
      {(paso === 1 || paso === 2) && (
        <>
          <video 
            ref={videoRef} 
            autoPlay 
            playsInline 
            className="absolute inset-0 w-full h-full object-cover z-0" 
          />
          <div className="absolute inset-0 bg-black/30 z-10 pointer-events-none"></div>
        </>
      )}

      {/* Interfaz de Captura 1 */}
      {paso === 1 && (
        <div className="absolute inset-0 z-20 flex flex-col items-center justify-between pb-12 pt-20">
          <div className="bg-black/60 px-6 py-3 rounded-full backdrop-blur-md">
            <p className="text-lg font-medium">Sitúate al inicio del muro</p>
          </div>
          
          <button 
            onClick={tomarPrimeraFoto}
            className="w-20 h-20 bg-white/20 rounded-full border-4 border-white flex items-center justify-center backdrop-blur-sm active:scale-95 transition-transform"
          >
            <div className="w-16 h-16 bg-white rounded-full"></div>
          </button>
        </div>
      )}

      {/* Interfaz de Captura 2 (Giroscopio) */}
      {paso === 2 && (
        <div className="absolute inset-0 z-20 flex flex-col items-center justify-center pb-12">
          
          <div className="bg-black/70 p-6 rounded-2xl backdrop-blur-md border border-gray-700 w-11/12 max-w-sm flex flex-col items-center shadow-2xl">
            <p className={`text-xl font-bold mb-6 transition-colors ${estaEstable ? 'text-green-400' : 'text-white'}`}>
              {estaEstable ? "¡Mantén firme el celular!" : "Gira a la derecha suavemente"}
            </p>

            {/* Barra de Guía Inercial */}
            <div className="w-full bg-gray-800 h-10 rounded-full relative overflow-hidden border border-gray-600 mb-2">
              {/* Zona de acierto (Target) */}
              <div className="absolute top-0 bottom-0 left-1/2 w-10 -ml-5 bg-green-500/30 border-x-2 border-green-500"></div>
              
              {/* Punto indicador que se mueve */}
              <div 
                className={`absolute top-1/2 -mt-3 w-6 h-6 rounded-full shadow-lg transition-all duration-100 ease-out z-10 ${estaEstable ? 'bg-green-400 scale-125' : 'bg-white'}`}
                style={{ 
                  // Calcula la posición. El multiplicador (ej. * 5) define qué tan rápido se mueve visualmente el punto
                  left: `calc(50% + ${(progreso - GRADOS_OBJETIVO) * 5}px)`,
                  transform: 'translateX(-50%)'
                }}
              ></div>
            </div>
          </div>
        </div>
      )}

      {/* Resultado Final (Paso 3) */}
      {paso === 3 && (
        <div className="absolute inset-0 z-50 bg-gray-900 overflow-y-auto p-6 flex flex-col items-center">
          <h2 className="text-2xl font-bold mb-2 mt-4 text-green-400">Captura Completada</h2>
          <p className="text-gray-400 mb-8 text-center">Las imágenes están listas para el algoritmo de costura.</p>
          
          <div className="flex flex-col gap-4 w-full max-w-md">
            <div className="relative">
              <span className="absolute top-2 left-2 bg-black/70 px-2 py-1 text-xs rounded font-bold">Foto 1 (Izquierda)</span>
              <img src={fotos[0]} alt="Parte izquierda del muro" className="w-full rounded-lg border border-gray-700" />
            </div>
            <div className="relative">
              <span className="absolute top-2 left-2 bg-black/70 px-2 py-1 text-xs rounded font-bold">Foto 2 (Derecha)</span>
              <img src={fotos[1]} alt="Parte derecha del muro" className="w-full rounded-lg border border-gray-700" />
            </div>
          </div>

          <div className="mt-8 flex gap-4 w-full max-w-md pb-8">
            <button 
              onClick={() => {
                setFotos([]);
                setPaso(1);
              }}
              className="flex-1 bg-gray-800 hover:bg-gray-700 py-3 rounded-lg font-semibold"
            >
              Repetir
            </button>
            <button 
              onClick={() => alert("Aquí conectaremos OpenCV en la Fase 2")}
              className="flex-1 bg-blue-600 hover:bg-blue-500 py-3 rounded-lg font-bold"
            >
              Procesar Plano
            </button>
          </div>
        </div>
      )}

    </div>
  );
};

export default CapturaObrin;
